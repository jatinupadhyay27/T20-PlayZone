# Copy to .env.local and fill in your own EmailJS account details
# (https://www.emailjs.com — free tier available) to enable real email
# sending from the Contact Us form. Without these, the form falls back
# to opening the user's own email client via a mailto: link.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# WhatsApp number (digits only, with country code, no "+") that "Message on
# WhatsApp" buttons across the site open a chat with.
VITE_WHATSAPP_PHONE_NUMBER=

# Inbox that Contact Us form submissions are delivered to.
VITE_CONTACT_RECIPIENT_EMAIL=

# Live Matches uses SportScore's free, keyless API (sportscore.com) directly —
# no env var needed here.
